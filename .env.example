# learning-tracker configuration. Copy to .env and fill in the <placeholders>.
# Every setting is read from the environment; see docs/configuration.md once it exists.
# Never commit .env.

# Required. At least 32 random bytes, base64: openssl rand -base64 48
LT_SECRET_KEY=<generate-with-openssl-rand-base64-48>

# Required. Password for the bundled Postgres container.
LT_DB_PASSWORD=<choose-a-long-random-password>

# Required. The origin users open, e.g. https://reads.example.com
LT_PUBLIC_ORIGIN=<https://reads.example.com>

# Required. Your own Anthropic API key (used only by the worker).
LT_ANTHROPIC_API_KEY=<your-anthropic-api-key>
