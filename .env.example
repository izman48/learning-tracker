# learning-tracker configuration. Copy to .env and fill in the <placeholders>.
# Every setting is read from the environment; see docs/configuration.md.
# An empty value means "use the default". Unknown LT_* names stop startup.
# Never commit .env.

# --- Required ---
# At least 32 random bytes, base64: openssl rand -base64 48
LT_SECRET_KEY=<generate-with-openssl-rand-base64-48>
# Password for the bundled Postgres container.
LT_DB_PASSWORD=<choose-a-long-random-password>
# The origin users open, e.g. https://reads.example.com
LT_PUBLIC_ORIGIN=<https://reads.example.com>
# Your own Anthropic API key (used only by the worker).
LT_ANTHROPIC_API_KEY=<your-anthropic-api-key>

# --- Access ---
LT_INVITE_REQUIRED=true
LT_MAX_USERS=50
LT_SESSION_DAYS=30
LT_MAX_TOPICS_PER_USER=3

# --- Network (read by docker compose) ---
LT_BIND_ADDRESS=127.0.0.1
LT_HTTP_PORT=8080
# Only with the tls profile: the hostname Caddy gets a certificate for.
LT_PUBLIC_HOSTNAME=
# Only behind your own reverse proxy: its IP address(es). Never *.
LT_TRUSTED_PROXY_IPS=
LT_EDGE_SUBNET=172.31.251.0/24
LT_CADDY_IP=172.31.251.10
LT_FETCH_EGRESS_SUBNET=172.31.250.0/24
# Only for an external Postgres; otherwise built from LT_DB_PASSWORD.
LT_DATABASE_URL=

# --- Models and spend caps (USD) ---
LT_MODEL_SEARCH=claude-haiku-5-5
LT_MODEL_PROFILE=claude-haiku-5-5
LT_MODEL_SCREEN=claude-haiku-5-5
LT_MODEL_CHOOSE=claude-haiku-5-5
LT_MODEL_EXPLAIN=claude-haiku-5-5
LT_PRICE_OVERRIDES={}
LT_SPEND_CAP_INSTANCE_MONTHLY_USD=10
LT_SPEND_CAP_USER_MONTHLY_USD=1.50
LT_SPEND_CAP_USER_DAILY_USD=0.15
LT_SEARCHES_PER_LIST_MAX=2
LT_SEARCH_RESULT_TOKEN_ALLOWANCE=15000

# --- Sources ---
LT_SOURCE_ANTHROPIC_SEARCH=true
LT_SOURCE_HN=false
LT_DISCUSSION_HN=false
LT_FETCH_CONTACT_URL=https://github.com/izman48/learning-tracker
LT_DOMAIN_BLOCKLIST_FILE=

# --- Nightly run (times are each user's local time) ---
LT_PIPELINE_START=02:00
LT_LIST_READY_BY=06:00
LT_WORKER_CONCURRENCY=2
LT_RUN_BUDGET_SECONDS=480

# --- Retention and backups (days) ---
LT_RETENTION_DAYS_LISTS=90
LT_RETENTION_DAYS_RUNS=90
LT_BACKUP_KEEP_DAYS=14

# --- Email (optional). Leave LT_SMTP_HOST empty for admin reset links only. ---
LT_SMTP_HOST=
LT_SMTP_PORT=587
LT_SMTP_TLS=required
LT_SMTP_USER=
LT_SMTP_PASSWORD=
LT_SMTP_FROM=
LT_RESET_TOKEN_MINUTES=30
LT_CONFIRM_TOKEN_HOURS=24

# --- Diagnostics ---
LT_DEBUG=false
LT_LOG_LEVEL=info
